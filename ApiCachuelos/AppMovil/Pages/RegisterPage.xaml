<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMovil.Pages.RegisterPage"
             Title="RegisterPage">
    <Grid
        VerticalOptions="Center">
        <Border
            Padding="10"
            Margin="15"
            StrokeThickness="3" >
            <StackLayout>
                <Label 
                    Margin="0,10,0,0"
                    HorizontalTextAlignment="Center"
                    Text="🚀 Comienza a trabajar con nosotros"
                    FontSize="Title"
                    FontAttributes="Bold"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />
                <Label 
                    Text="Busca y Consigue trabajos de una manera facil y divertida!"
                    FontSize="Subtitle"
                    TextColor="Black"
                    HorizontalTextAlignment="Center"
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" />

                <Label 
                    Margin="0,20,0,0"
                    Text="Nombre de Usuario" 
                    FontAttributes="Bold"/>
                <Border>
                    <Entry 
                        Placeholder="Juan Bonachon"
                        PlaceholderColor="Gray"/>
                </Border>
                <Label 
                    Margin="0,10,0,0"
                    Text="Correo" 
                    FontAttributes="Bold"/>
                <Border>
                    <Entry 
                        Placeholder="correo@ejemplo.com"
                        PlaceholderColor="Gray"/>
                </Border>
                <Label 
                    Margin="0,10,0,0"
                    Text="Contraseña" 
                    FontAttributes="Bold"/>
                <Border>
                    <Entry 
                        Placeholder="••••••••"
                        PlaceholderColor="Gray"
                        IsPassword="True"/>
                </Border>
                <Button 
                    Margin="0,15,0,0"
                    Text="Iniciar sesión"
                    FontAttributes="Bold"
                    FontSize="Subtitle"/>
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Margin="0,5,0,0">
                    <Label 
                        Text="¿Ya tienes cuenta? "/>
                    <Label 
                        TextColor="Blue"
                        FontAttributes="Bold"
                        Text="Inicia sesión" >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLabelTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </StackLayout>
        </Border>
    </Grid>
</ContentPage>